# ==============================================================================
# APEX PULSE — Formula 1 AI Race Strategy Engine
# Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to .env and configure for your local or production environment.
# DO NOT commit real secrets or production credentials to version control.

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Server host interface and port (Port is automatically set by cloud PaaS like Render/Railway)
HOST=0.0.0.0
PORT=8000

# Telemetry data ingestion mode: 'synthetic' (built-in 20Hz loop) or 'udp' (EA Sports F1 UDP)
TELEMETRY_MODE=synthetic
UDP_BIND_PORT=20777

# Allowed CORS Origins: Comma-separated list of frontend domains
# In development: http://localhost:5173,http://localhost:3000
# In production: https://your-apex-pulse-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional: External persistent database connection string (if plugged into PostgreSQL/Supabase)
DATABASE_URL=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Backend API Base URL
# In local development: Leave empty to use the Vite dev proxy
# In production: Set to your public backend URL (e.g., https://apex-pulse-api.onrender.com)
VITE_API_URL=

# Real-time WebSocket URL
# If omitted, it is automatically derived from VITE_API_URL (http->ws, https->wss) + '/ws'
VITE_WS_URL=

# ------------------------------------------------------------------------------
# WEBRTC RACE RADIO (STUN / TURN) CONFIGURATION
# ------------------------------------------------------------------------------
# STUN Server: Used for discovering public IP addresses (Google STUN is default)
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# TURN Relay Server: Required for reliable cross-network audio across symmetric NATs / mobile cellular
# Free TURN servers can be obtained from Metered.ca, Twilio, or Xirsys
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
