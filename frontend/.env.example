# ==============================================================================
# APEX PULSE Frontend — Environment Variables (.env.example)
# ==============================================================================

# Backend API URL (Production cloud host)
# Local development: Leave blank to use Vite dev server proxy
# Production: https://your-apex-pulse-backend.onrender.com
VITE_API_URL=

# WebSocket URL (Auto-derived from VITE_API_URL if omitted)
# Production: wss://your-apex-pulse-backend.onrender.com/ws
VITE_WS_URL=

# WebRTC STUN / TURN Configuration
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
